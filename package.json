{
  "name": "karada-log",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "食事を記録して、その日のカロリー・たんぱく質・脂質・塩分を目標と比べながら確認できる、個人用の減量管理 PWA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kerokero-1245/karada-log.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --import ./tests/setup.mjs \"tests/**/*.test.ts\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@tailwindcss/vite": "^4.3.3",
    "dexie": "^4.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
